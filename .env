# Production addresses.
#
# These are inlined into the bundle at build time, so they are the values any build that does
# not set its own will ship with. Machine-specific values belong in .env.local, which overrides
# this file and is git-ignored; this file is committed, so it must never hold a localhost URL.
#
# The deploy environment (Netlify) may set these too, and anything it sets wins over this file.

# Public site address — canonical URLs, Open Graph and the sitemap are built from this.
NEXT_PUBLIC_SITE_URL=https://pdf-studio.laxmi.solutions

# pdf-studio-api. The same deployment the mobile app talks to.
NEXT_PUBLIC_API_URL=https://pdf-studio-api.laxmi.solutions

# Auth instance issuing anonymous guest tokens — its own database and issuer, kept separate
# from the account space so a flood of throwaway guests cannot reach real accounts.
NEXT_PUBLIC_GUEST_AUTH_URL=https://auth-web.laxmi.solutions

# Auth instance holding real accounts — the SAME one the mobile app uses, so signing in on the
# web gives the same account and the same credit balance.
NEXT_PUBLIC_ACCOUNT_AUTH_URL=https://auth.laxmi.solutions

# Mirrors the API's multipart limit so oversized files are rejected before uploading.
NEXT_PUBLIC_MAX_FILE_BYTES=52428800

# Google sign-in. Empty disables the button rather than showing one that cannot work.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
