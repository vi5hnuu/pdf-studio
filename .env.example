# Public site address — canonical URLs, Open Graph and the sitemap are built from this.
NEXT_PUBLIC_SITE_URL=https://pdf-studio.laxmi.solutions

# pdf-studio-api.
NEXT_PUBLIC_API_URL=https://pdf-studio-api.laxmi.solutions

# Auth instance issuing anonymous guest tokens (its own database, separate from accounts).
NEXT_PUBLIC_GUEST_AUTH_URL=https://auth-web.laxmi.solutions

# Auth instance holding real accounts — the SAME one the mobile app uses, so signing in on
# the web gives the same account and the same credit balance.
NEXT_PUBLIC_ACCOUNT_AUTH_URL=https://auth.laxmi.solutions

# Mirrors the API's multipart limit so oversized files are rejected before uploading.
NEXT_PUBLIC_MAX_FILE_BYTES=52428800

# Google sign-in. Empty disables the button rather than showing one that cannot work.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# NOTE: these are inlined at build time — a NEXT_PUBLIC_ variable cannot be read at runtime, so
# whatever is set when the bundle is built is what ships. .env now holds the production values,
# so a build with no other configuration is already correct; anything the deploy environment
# (Netlify) sets takes precedence over it.
#
# For local development copy this file to .env.development.local, NOT .env.local: Next loads
# .env.local in every environment including a production build, so localhost values there would
# be baked into a bundle built on your machine. Both are git-ignored.
