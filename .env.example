# Public site address — canonical URLs, Open Graph and the sitemap are built from this.
NEXT_PUBLIC_SITE_URL=https://pdf-studio.laxmi.solutions

# pdf-studio-api.
NEXT_PUBLIC_API_URL=https://pdf-studio-api.laxmi.solutions

# Auth instance issuing anonymous guest tokens (its own database, separate from accounts).
NEXT_PUBLIC_GUEST_AUTH_URL=https://auth-web.laxmi.solutions

# Auth instance holding real accounts — the SAME one the mobile app uses, so signing in on
# the web gives the same account and the same credit balance.
NEXT_PUBLIC_ACCOUNT_AUTH_URL=https://auth.laxmi.solutions

# Mirrors the API's multipart limit so oversized files are rejected before uploading.
NEXT_PUBLIC_MAX_FILE_BYTES=52428800
